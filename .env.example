# Port the API listens on
PORT=4000

# PostgreSQL. The defaults match docker-compose.yml.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=haupcar

# Database used by npm test. The tests empty its tables, so don't point it at real data.
DB_NAME_TEST=haupcar_test

# Allowed origin for CORS. Use * to allow any origin.
CORS_ORIGIN=*

# Print every SQL query Sequelize runs
DB_LOGGING=false

{
  "name": "car-management-api",
  "version": "1.0.0",
  "private": true,
  "description": "REST API for haupcar-management",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migration-up": "sequelize-cli db:migrate",
    "migration-down": "sequelize-cli db:migrate:undo",
    "migration-status": "sequelize-cli db:migrate:status",
    "migration-generate": "sequelize-cli migration:generate --name",
    "test": "NODE_ENV=test sequelize-cli db:migrate && node --test --test-concurrency=1"
  },
  "engines": {
    "node": ">=20.17"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "sequelize-cli": "^6.6.5",
    "supertest": "^7.3.2"
  },
  "overrides": {
    "sequelize": {
      "uuid": "^11.1.1"
    },
    "js-beautify": {
      "glob": "^14.0.6",
      "editorconfig": "^4.0.1"
    }
  }
}
